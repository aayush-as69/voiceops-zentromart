# LLM: any OpenAI-compatible provider works. Use your own key and the matching model and base URL.
# If LLM_MODEL and LLM_BASE_URL are left commented out, the OpenAI API and gpt-4.1-mini are used.
LLM_API_KEY=

# Pick ONE provider block and uncomment its two lines.
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Gemini (Google AI Studio):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# OpenAI:
# LLM_MODEL=gpt-4.1-mini

# Required only for live speech input/output.
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# Path to the extracted challenge dataset directory (not the ZIP file).
DATASET_DIR=./dataset/Capstone_Project_Dataset_FTTT_2026
VECTOR_STORE_PATH=./storage/vector_index.joblib
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000