# Gemini via Google AI Studio OpenAI-compatible endpoint. API key is provided locally by you.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Required only for live speech input/output.
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# Path to the extracted challenge dataset directory (not the ZIP file).
DATASET_DIR=./dataset/Capstone_Project_Dataset_FTTT_2026
VECTOR_STORE_PATH=./storage/vector_index.joblib
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
